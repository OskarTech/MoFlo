{
  "expo": {
    "name": "MoFlo",
    "slug": "moflo",
    "version": "2.0.0",
    "scheme": "moflo",
    "orientation": "portrait",
    "icon": "./assets/icon/ios-light.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "bundleIdentifier": "com.oskartech.moflo",
      "buildNumber": "200",
      "icon": {
        "light": "./assets/icon/ios-light.png",
        "dark": "./assets/icon/ios-dark.png",
        "tinted": "./assets/icon/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/android-foreground.png",
        "backgroundImage": "./assets/icon/android-background.png",
        "monochromeImage": "./assets/icon/android-monochrome.png",
        "backgroundColor": "#166534"
      },
      "package": "com.oskartech.moflo",
      "versionCode": 200,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/notification.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MoFlo uses your photos only when you choose a profile or shared account picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "forceStaticLinking": ["RNFBApp", "RNFBAuth", "RNFBFirestore", "RNFBMessaging", "RNFBCrashlytics", "RNFBStorage"],
            "useFrameworks": "static"
          },
          "android": {
            "googleServicesFile": "./google-services.json"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "e60975e2-f412-4a99-981a-6624ed1bcaae"
      }
    },
    "owner": "oskartech"
  }
}